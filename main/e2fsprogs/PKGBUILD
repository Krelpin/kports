# Contributor: Ronald van Haren <ronald.archlinux.org>
# Contributor: judd <jvinet@zeroflux.org>

pkgname=e2fsprogs
pkgver=1.47.4
pkgrel=1
pkgdesc='Ext2/3/4 filesystem utilities'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later' 'MIT')
url='https://e2fsprogs.sourceforge.net'
depends=('sh' 'util-linux')
provides=('libcom_err.so' 'libe2p.so' 'libext2fs.so' 'libss.so')
backup=('etc/mke2fs.conf')
source=("https://kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${pkgver}/e2fsprogs-${pkgver}.tar.xz")
sha256sums=('fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b')

prepare() {
  cd "${pkgname}-${pkgver}"
  # Remove unnecessary init.d directory
  sed -i '/init\.d/s|^|#|' misc/Makefile.in
}

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
      --prefix='/usr' \
      --with-root-prefix='' \
      --libdir='/usr/lib' \
      --libexecdir='/usr/lib' \
      --sbindir='/usr/bin' \
      --enable-elf-shlibs \
      --disable-fsck \
      --disable-uuidd \
      --disable-libuuid \
      --disable-libblkid \
      --disable-fuse2fs
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install install-libs

  sed -i -e 's/^AWK=.*/AWK=awk/' "${pkgdir}/usr/bin/compile_et"
  sed -i -e 's#^DIR=.*#DIR="/usr/share/ss"#' "${pkgdir}/usr/bin/mk_cmds"
  sed -i -e 's#^DIR=.*#DIR="/usr/share/et"#' "${pkgdir}/usr/bin/compile_et"

  # remove static libraries with a shared counterpart
  rm -f "${pkgdir}"/usr/lib/lib{com_err,e2p,ext2fs,ss}.a
}
