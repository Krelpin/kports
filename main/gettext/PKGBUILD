# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=gettext
pkgver=0.24
pkgrel=1
pkgdesc='GNU internationalization library and tools'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/gettext/'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'acl' 'glibc' 'libunistring' 'libxml2' 'ncurses' 'sh')
provides=('libasprintf.so' 'libgettextlib.so' 'libgettextpo.so' 'libgettextsrc.so' 'libtextstyle.so')
source=("https://ftp.gnu.org/pub/gnu/${pkgname}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --disable-static \
    --enable-nls \
    --with-libxml2-prefix=/usr \
    --without-git \
    --without-cvs \
    --without-bzip2 \
    --without-xz
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
