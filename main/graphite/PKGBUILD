# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=graphite
pkgver=1.3.15
pkgrel=1
pkgdesc='A "smart font" system to handle the complexities of lesser-known languages of the world'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://graphite.sil.org/'
license=('LGPL-2.1-or-later OR MPL-2.0 OR GPL-2.0-or-later')
depends=('glibc' 'gcc-libs')
makedepends=('cmake' 'ninja' 'python')
provides=('libgraphite2.so')
source=("https://github.com/silnrsi/graphite/releases/download/${pkgver}/graphite2-${pkgver}.tgz"
        'gcc15.patch')
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "graphite2-${pkgver}"
  patch -Np1 -i ../gcc15.patch
}

build() {
  cmake -B build -S "graphite2-${pkgver}" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DCMAKE_SKIP_INSTALL_RPATH=ON \
    -DGRAPHITE2_COMPARE_RENDERER=OFF \
    -DGRAPHITE2_VM_TYPE=direct
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
