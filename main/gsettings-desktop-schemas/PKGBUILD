# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=gsettings-desktop-schemas
pkgver=47.1
pkgrel=1
pkgdesc='Shared GSettings schemas for the GNOME desktop'
arch=('any')
url='https://gitlab.gnome.org/GNOME/gsettings-desktop-schemas'
license=('LGPL-2.1-or-later')
depends=('glib2')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/${pkgname}/47/${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  meson setup "${pkgname}-${pkgver}" build \
    --prefix=/usr --libdir=lib --buildtype=release \
    -Dintrospection=false
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
