# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=pkgconf
pkgver=2.3.0
pkgrel=1
pkgdesc="Package compiler and linker metadata toolkit"
url="https://github.com/pkgconf/pkgconf"
license=(ISC)
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
depends=(glibc)
makedepends=(meson)
provides=(
  libpkgconf.so
  pkg-config
  pkgconfig
)
conflicts=(pkg-config)
replaces=(pkg-config)
source=(
  "https://distfiles.ariadne.space/pkgconf/pkgconf-${pkgver}.tar.xz"
)
sha256sums=('3a9080ac51d03615e7c1910a0a2a8df08424892b5f13b0628a204d3fcce0ea8b')

build() {
  meson setup build "pkgconf-${pkgver}" \
    --prefix=/usr \
    --buildtype=plain \
    -Dtests=disabled

  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Standard pkg-config symlink
  ln -sf pkgconf "$pkgdir/usr/bin/pkg-config"

  install -Dm644 "pkgconf-${pkgver}/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
