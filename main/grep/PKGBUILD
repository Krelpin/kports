pkgname=grep
pkgver=3.12
pkgrel=2
pkgdesc='A string search utility'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('GPL-3.0-or-later')
url='https://www.gnu.org/software/grep/'
depends=('glibc')
source=("https://ftp.gnu.org/gnu/grep/grep-${pkgver}.tar.gz")
sha256sums=('badda546dfc4b9d97e992e2c35f3b5c7f20522ffcbe2f01ba1e9cdcbe7644cdc')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-perl-regexp \
    --disable-gcc-warnings
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
