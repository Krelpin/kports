# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Giancarlo Razzolini <grazzolini@archlinux.org>
# Contributor: Frederik Schwan <freswa at archlinux dot org>

# toolchain build order: linux-api-headers->glibc->binutils->gcc->glibc->binutils->gcc

pkgname=binutils
pkgver=2.44
pkgrel=1
pkgdesc='A set of programs to assemble and manipulate binary and object files'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/binutils/'
license=(GPL-2.0-or-later GPL-3.0-or-later LGPL-2.0-or-later LGPL-3.0-or-later)
depends=(
  glibc
  zlib
  zstd
)
provides=(
  libctf.so
  libsframe.so
)
options=(
  staticlibs
)
source=(
  https://ftp.gnu.org/gnu/binutils/binutils-${pkgver}.tar.xz{,.sig}
)
sha256sums=('ce2017e059d63e67ddb9240e9d4ec49c2893605035cd60e92ad53177f4377237'
            'SKIP')
validpgpkeys=(3A24BC1E8FB409FA9F14371813FCEF89DD9E3C4F)

prepare() {
  rm -rf "${srcdir}/binutils-build"
  mkdir -p "${srcdir}/binutils-build"
  cd binutils-${pkgver}

  # Turn off development mode
  sed -i '/^development=/s/true/false/' bfd/development.sh
}

build() {
  cd "${srcdir}/binutils-build"

  local _conf_opts=()
  if [ -n "$CBUILDROOT" ] && [ -d "$CBUILDROOT" ]; then
    _conf_opts+=("--with-sysroot=$CBUILDROOT")
  fi

  "${srcdir}"/binutils-${pkgver}/configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-lib-path=/usr/lib:/usr/local/lib \
    --enable-colored-disassembly \
    --enable-default-execstack=no \
    --enable-deterministic-archives \
    --enable-ld=default \
    --enable-new-dtags \
    --enable-plugins \
    --enable-relro \
    --enable-shared \
    --enable-threads \
    --disable-gdb \
    --disable-gdbserver \
    --disable-gprofng \
    --disable-sim \
    --disable-werror \
    --with-pic \
    "${_conf_opts[@]}"

  make -O tooldir=/usr
}

check() {
  cd binutils-build
  make check || true
}

package() {
  cd binutils-build
  make DESTDIR="${pkgdir}" tooldir=/usr install

  # Remove unwanted man pages
  rm -f "${pkgdir}"/usr/share/man/man1/{dlltool,windres,windmc}* 2>/dev/null || true
}
