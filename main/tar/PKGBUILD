pkgname=tar
pkgver=1.35
pkgrel=1
pkgdesc='Utility used to store, backup, and transport files'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/tar/'
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/tar/tar-${pkgver}.tar.gz")
sha256sums=('14d55e32063ea9526e057fbf35fcabd53378e769787eff7919c3755b02d2b57e')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib/tar
  make WERROR_CFLAGS=""
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
