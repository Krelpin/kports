# Contributor: judd <jvinet@zeroflux.org>

pkgname=util-linux
pkgver=2.42.3
pkgrel=1
pkgdesc='Miscellaneous system utilities for Linux'
url='https://github.com/util-linux/util-linux'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('GPL-2.0-or-later')
depends=('glibc')
provides=('util-linux-libs' 'libutil-linux' 'libblkid.so' 'libfdisk.so' 'libmount.so' 'libsmartcols.so' 'libuuid.so')
replaces=('util-linux-libs')
conflicts=('util-linux-libs')
source=("https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-${pkgver}.tar.xz")
sha256sums=('66ac7c0e725278eb2b039e3104f2c91119341d941b41bac7a285c695f940bd57')

build() {
  cd "${pkgname}-${pkgver}"

  # util-linux' configure overrides the autoconf defaults with /bin and /lib
  # unless --bindir and --libdir are passed, which breaks the usrmerge layout.
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --bindir=/usr/bin \
    --sbindir=/usr/bin \
    --libdir=/usr/lib \
    --disable-static \
    --without-systemd \
    --without-systemdsystemunitdir \
    --without-python \
    --without-ncursesw \
    --without-cap-ng \
    --without-libz \
    --without-libmagic \
    --without-btrfs \
    --without-econf \
    --without-user \
    --without-udev \
    --without-readline \
    --disable-pam-lastlog2 \
    --disable-chfn-chsh \
    --disable-login \
    --disable-nologin \
    --disable-su \
    --disable-sulogin \
    --disable-pylibmount
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
