# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=linux-pam
pkgver=1.6.1
pkgrel=1
pkgdesc='Pluggable Authentication Modules for Linux'
arch=('aarch64' 'armv7h')
url='https://github.com/linux-pam/linux-pam'
license=('BSD-3-Clause' 'GPL-2.0-or-later')
depends=('glibc' 'libxcrypt')
provides=('pam')
source=("https://github.com/linux-pam/linux-pam/releases/download/v${pkgver}/Linux-PAM-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  cd "Linux-PAM-${pkgver}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libdir=/usr/lib \
    --sbindir=/usr/bin \
    --disable-audit \
    --disable-selinux \
    --disable-nls \
    --disable-regenerate-docu \
    --disable-nis \
    --disable-econf
  make
}

package() {
  cd "Linux-PAM-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
