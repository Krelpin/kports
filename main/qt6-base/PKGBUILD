# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=qt6-base
_qtver=6.8.2
pkgver=${_qtver/-/}
pkgrel=1
pkgdesc='A cross-platform application and UI framework'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.qt.io'
license=('GPL-3.0-only' 'LGPL-3.0-only' 'LicenseRef-Qt-Commercial')
# Arch also links libx11, libxcb, xcb-util-*, mesa, libgl, libcups, krb5,
# liburing, tslib and systemd-libs. Krelpin phones run Wayland only and reach
# the GPU through the Android HALs, so those are left out on purpose.
depends=('brotli' 'dbus' 'double-conversion' 'fontconfig' 'freetype' 'glib2'
         'glibc' 'gcc-libs' 'harfbuzz' 'icu' 'libb2' 'libdrm' 'libhybris'
         'libinput' 'libjpeg-turbo' 'libpng' 'libproxy' 'libxkbcommon' 'md4c'
         'mtdev' 'openssl' 'pcre2' 'shared-mime-info' 'sqlite' 'wayland' 'zlib'
         'zstd')
makedepends=('cmake' 'ninja' 'perl' 'python' 'vulkan-headers' 'wayland-protocols')
_pkgfn="qtbase-everywhere-src-${_qtver}"
source=("https://download.qt.io/official_releases/qt/${_qtver%.*}/${_qtver}/submodules/${_pkgfn}.tar.xz")
sha256sums=('SKIP')

build() {
  cmake -B build -S "${_pkgfn}" -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DINSTALL_BINDIR=lib/qt6/bin \
    -DINSTALL_PUBLICBINDIR=bin \
    -DINSTALL_LIBEXECDIR=lib/qt6 \
    -DINSTALL_DOCDIR=share/doc/qt6 \
    -DINSTALL_ARCHDATADIR=lib/qt6 \
    -DINSTALL_DATADIR=share/qt6 \
    -DINSTALL_INCLUDEDIR=include/qt6 \
    -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
    -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples \
    -DFEATURE_journald=OFF \
    -DFEATURE_libproxy=ON \
    -DFEATURE_openssl_linked=ON \
    -DFEATURE_system_sqlite=ON \
    -DFEATURE_no_direct_extern_access=OFF \
    -DFEATURE_mimetype_database=OFF \
    -DFEATURE_openssl_hash=ON \
    -DFEATURE_xcb=OFF \
    -DFEATURE_cups=OFF \
    -DFEATURE_gssapi=OFF \
    -DFEATURE_opengl_es2=ON \
    -DFEATURE_wayland=ON \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
