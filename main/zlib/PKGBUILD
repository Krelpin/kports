# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=zlib
pkgver=1.3.1
pkgrel=1
pkgdesc='Compression library implementing the deflate compression method'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.zlib.net/'
license=('Zlib')
depends=('glibc')
provides=('libz.so')
source=("https://zlib.net/fossils/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --libdir=/usr/lib
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
