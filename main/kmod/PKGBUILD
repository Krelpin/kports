# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Dave Reisner <dreisner@archlinux.org>

pkgname=kmod
pkgver=34.2
pkgrel=1
pkgdesc="Linux kernel module management tools and library"
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git'
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later')
depends=('glibc' 'xz' 'zstd')
makedepends=('meson')
provides=('libkmod.so')
source=("https://kernel.org/pub/linux/utils/kernel/kmod/kmod-${pkgver}.tar.xz"
        'depmod-search.conf'
        'depmod.hook'
        'depmod.script')
sha256sums=('5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54'
            '1a92bfeae870f61ce814577e69d2a147a9c0caf6aed1131243e4179241fcc4a8'
            'c11c2a0f66ea405493e8617689ca10818dc81dd1dddc19bdb220c8b2917119c1'
            '18661aa40c25580f04d2ac3f32e54c2997c0994d1c829905537b413a9d291ac6')

build() {
  meson setup build "kmod-${pkgver}" \
    --prefix=/usr \
    --sysconfdir=/etc \
    -Dbuild-tests=false \
    -Dmanpages=false \
    -Dopenssl=disabled \
    -Dzlib=disabled \
    -Dxz=enabled \
    -Dzstd=enabled

  meson compile -C build
}

check() {
  true
}

package() {
  meson install -C build --destdir "$pkgdir"

  # extra directories
  install -dm0755 "${pkgdir}"/{etc,usr/lib}/{depmod,modprobe}.d

  # install depmod.d file for search/ dir
  install -Dm0644 "${srcdir}/depmod-search.conf" "${pkgdir}/usr/lib/depmod.d/search.conf"

  # hook
  install -Dm0644 "${srcdir}/depmod.hook" "${pkgdir}/usr/share/libalpm/hooks/60-depmod.hook"
  install -Dm0755 "${srcdir}/depmod.script" "${pkgdir}/usr/share/libalpm/scripts/depmod"
}
