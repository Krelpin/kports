# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=python
pkgver=3.12.9
pkgrel=1
pkgdesc='Interpreted, interactive, object-oriented programming language'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.python.org/'
license=('Python-2.0.1')
# TODO: add gdbm and libnsl once ported
depends=('glibc' 'zlib' 'zstd' 'bzip2' 'xz' 'expat' 'libffi' 'libxcrypt' 'mpdecimal'
         'openssl' 'ncurses' 'readline' 'sqlite' 'tzdata')
provides=('libpython3.12.so' 'python3')
source=("https://www.python.org/ftp/python/${pkgver}/Python-${pkgver}.tar.xz")
sha256sums=('SKIP')

prepare() {
  cd "Python-${pkgver}"
  rm -r Modules/expat
  rm -r Modules/_decimal/libmpdec
}

build() {
  cd "Python-${pkgver}"

  # RUNSHARED is baked in at configure time and used to run the new
  # interpreter, so the sysroot has to be visible here too
  export LD_LIBRARY_PATH="${SYSROOT}/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --enable-shared \
    --with-system-expat \
    --with-system-libmpdec \
    --without-ensurepip \
    --enable-optimizations=no \
    --with-computed-gotos

  make
}

package() {
  cd "Python-${pkgver}"
  # makepkg's own tools must not pick up the sysroot libraries
  unset LD_LIBRARY_PATH
  make DESTDIR="${pkgdir}" install
  ln -sf python3 "${pkgdir}/usr/bin/python"
}
