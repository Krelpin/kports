pkgbase=gcc
pkgname=(gcc gcc-libs)
pkgver=16.2.1+r23+gd564253eb6c8
_commit=d564253eb6c859e266d3cae18e82fb4db9a88316
pkgrel=1
pkgdesc='The GNU Compiler Collection (C and C++ frontends)'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('GPL-3.0-or-later WITH GCC-exception-3.1' 'GFDL-1.3-or-later')
url='https://gcc.gnu.org'
makedepends=(
  binutils
  git
  python
  zlib
  zstd
)
options=(
  !emptydirs
  !lto
  staticlibs
)
_libdir=usr/lib/gcc/$CHOST/${pkgver%%.*}
source=(
  git+https://forge.sourceware.org/gcc/gcc#commit=$_commit
  c89
  c99
)
sha256sums=('c4def1816bc86f2bb981deb958a572ca63eb0ef784418f0414f1071a4efee44d'
            '7b09ec947f90b98315397af675369a1e3dfc527fa70013062e6e85c4be0275ab'
            '44ea973558842f3f4bd666bdaf6e810fd7b7c7bd36b5cc4c69f93d2cd0124fc7')

prepare() {
  [[ ! -d gcc ]] && ln -s gcc-${pkgver/+/-} gcc
  cd gcc

  # Download in-tree GMP, MPFR, MPC, and ISL prerequisites if missing
  if [[ ! -d gmp ]]; then
    msg "Downloading in-tree GMP, MPFR, MPC, and ISL prerequisites..."
    ./contrib/download_prerequisites --no-verify
  fi

  mkdir -p "$srcdir"/gcc-build
}

build() {
  local _confflags=(
      --prefix=/usr
      --libdir=/usr/lib
      --libexecdir=/usr/lib
      --mandir=/usr/share/man
      --infodir=/usr/share/info
      --with-bugurl=https://krelpin.org
      --with-linker-hash-style=gnu
      --with-system-zlib
      --enable-checking=release
      --enable-clocale=gnu
      --enable-default-pie
      --enable-default-ssp
      --enable-gnu-indirect-function
      --enable-gnu-unique-object
      --enable-libstdcxx-backtrace
      --enable-link-serialization=1
      --enable-linker-build-id
      --enable-lto
      --disable-multilib
      --enable-plugin
      --enable-shared
      --enable-threads=posix
      --disable-bootstrap
      --disable-fixincludes
      --disable-libssp
      --disable-libstdcxx-pch
      --disable-werror
  )

  cd gcc-build

  CFLAGS=${CFLAGS/-Werror=format-security/}
  CXXFLAGS=${CXXFLAGS/-Werror=format-security/}

  ../gcc/configure \
    --enable-languages=c,c++,lto \
    "${_confflags[@]:?_confflags unset}"

  make -O
}

check() {
  # Skip lengthy test suite during toolchain bootstrap
  true
}

package_gcc() {
  pkgdesc="The GNU Compiler Collection - C and C++ frontends"
  depends=(
    "gcc-libs=$pkgver-$pkgrel"
    'binutils>=2.28'
    'glibc>=2.27'
    zlib
    zstd
  )
  provides=('gcc' 'g++' 'cpp')
  options=(!emptydirs staticlibs)

  cd gcc-build
  make DESTDIR="$pkgdir" install

  # Symlink cc to gcc and c++ to g++
  ln -sf gcc "$pkgdir"/usr/bin/cc
  ln -sf g++ "$pkgdir"/usr/bin/c++

  # Install POSIX c89 and c99 wrappers
  install -Dm755 "$srcdir"/c89 "$pkgdir"/usr/bin/c89
  install -Dm755 "$srcdir"/c99 "$pkgdir"/usr/bin/c99

  # Prepare internal runtime libraries directory for gcc-libs.
  # GCC installs these into /usr/lib64 on this target, which is not on the
  # linker path, so collect from both locations and ship them in /usr/lib.
  rm -rf "$srcdir"/gcc-libs-pkg
  install -dm755 "$srcdir"/gcc-libs-pkg/usr/lib
  for _lib in "$pkgdir"/usr/lib{,64}/lib{gcc_s,stdc++,atomic,gomp}.so*; do
    if [ -e "$_lib" ]; then
      mv "$_lib" "$srcdir"/gcc-libs-pkg/usr/lib/
    fi
  done
}

package_gcc-libs() {
  pkgdesc='Runtime libraries shipped by GCC'
  depends=('glibc>=2.27')
  provides=('gcc-libs' 'libgcc' 'libstdc++' 'libatomic' 'libgomp')
  replaces=('libgcc' 'libstdc++' 'libatomic' 'libgomp')

  install -dm755 "$pkgdir"/usr/lib
  if [ -d "$srcdir"/gcc-libs-pkg/usr/lib ]; then
    cp -a "$srcdir"/gcc-libs-pkg/usr/lib/* "$pkgdir"/usr/lib/ 2>/dev/null || true
  fi
}
