# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libcallaudio
pkgver=0.1.8
pkgrel=1
pkgdesc='Client library for the call audio routing daemon'
arch=('aarch64' 'armv7h')
url='https://gitlab.com/mobian1/callaudiod'
license=('LGPL-3.0-or-later')
depends=('glib2')
makedepends=('meson' 'ninja' 'pkgconf')
source=("${url}/-/archive/${pkgver}/callaudiod-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "callaudiod-${pkgver}"
  # Phosh only consumes the client ABI.  Keep the generated DBus interface and
  # library, but leave the ALSA/PulseAudio routing daemon and tools separate.
  sed -i "/subdir('src')/d; /subdir('tools')/d; /subdir('doc')/d" meson.build
  sed -i '/^# systemd service file/,$d' data/meson.build
}

build() {
  meson setup "callaudiod-${pkgver}" build-${pkgver} \
    --prefix=/usr --libdir=lib --buildtype=release
  meson compile -C build-${pkgver}
}

package() {
  meson install -C build-${pkgver} --destdir "${pkgdir}"
}
