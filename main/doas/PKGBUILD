# Contributor: T.J. Townsend <blakkheim@archlinux.org>

pkgname=doas
pkgver=6.8.2
pkgrel=3
pkgdesc='Run commands as super user or another user'
url='https://github.com/Duncaen/OpenDoas'
license=('ISC')
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
depends=('glibc')
provides=('opendoas')
replaces=('opendoas')
source=("https://github.com/Duncaen/OpenDoas/releases/download/v${pkgver}/opendoas-${pkgver}.tar.gz")
sha256sums=('28dca29adec5f4336465812d9e2243f599e62a78903de71c24f0cd6fe667edac')

build() {
  cd "opendoas-${pkgver}"
  ./configure --prefix=/usr --with-timestamp --without-pam
  make
}

check() {
  true
}

package() {
  cd "opendoas-${pkgver}"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"

  install -dm0755 "$pkgdir/etc"
  echo "permit persist :wheel" > "$pkgdir/etc/doas.conf"
  chmod 0600 "$pkgdir/etc/doas.conf"
}
