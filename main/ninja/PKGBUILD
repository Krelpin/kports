# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=ninja
pkgver=1.12.1
pkgrel=1
pkgdesc='Small build system with a focus on speed'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://ninja-build.org/'
license=('Apache-2.0')
depends=('glibc' 'gcc-libs')
makedepends=('cmake' 'python')
source=("https://github.com/ninja-build/ninja/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  cd "${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 misc/bash-completion "${pkgdir}/usr/share/bash-completion/completions/ninja"
  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
