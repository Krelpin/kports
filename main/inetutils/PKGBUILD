# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=inetutils
pkgver=2.6
pkgrel=1
pkgdesc='A collection of common network programs, built for hostname'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/inetutils/'
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/${pkgname}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --bindir=/usr/bin \
    --sbindir=/usr/bin \
    --localstatedir=/var \
    --sysconfdir=/etc \
    --disable-servers \
    --disable-ftp --disable-telnet --disable-rsh --disable-rlogin \
    --disable-rcp --disable-rexec --disable-logger --disable-talk \
    --disable-tftp --disable-whois --disable-ifconfig --disable-traceroute \
    --enable-hostname --enable-ping --enable-ping6
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
