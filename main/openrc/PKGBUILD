pkgname=openrc
pkgver=0.63.3
pkgrel=1
pkgdesc='Dependency based init system for Krelpin Linux'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://github.com/OpenRC/openrc'
license=('BSD-2-Clause')
depends=('glibc' 'libcap')
makedepends=('meson')
provides=('librc.so' 'init-rc' 'libeinfo.so' 'svc-manager')
backup=(etc/inittab
        etc/rc.conf
        etc/conf.d/{bootmisc,consolefont,devfs,dmesg,fsck,hostname,hwclock,keymaps}
        etc/conf.d/{killprocs,localmount,modules,netmount,network,staticroute,swap})
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/OpenRC/openrc/archive/${pkgver}.tar.gz"
        'openrc.logrotate')
b2sums=('d66bd09f1860a2f42a07283fe5082429934365b3ddf206e7437457cf70767b77aab8b0ab101b050cb5ff8910eff3c1717df06b4dc96e03b0850007ca5a456a02'
        'f283de20b5a07e3c5d21a28b9de72f0a71fd2cc1b70a5567db80373c7144aec0e6ac217eef77acbbb05eff2134c22ee6746b7f248abc4587042c456ed0a32a31')

prepare() {
    cd "$pkgname-$pkgver"
    # replace system's halt with openrc-halt (the previous won't work on a non-systemd boot)
    sed -ie 's!halt -w!openrc-shutdown -w!g' init.d/bootmisc.in
    # reduce modules verbosity
    sed -it 's!--verbose!!g' init.d/modules.in
    # override VCS_TAG (it fails and we're doing a tar build anyway)
    sed -it 's!vcs_tag(!vcs_tag(\n\tcommand : [ '\'echo\'', '\'$pkgver\'', ],!g' src/shared/meson.build
}

build() {
    meson setup build "$pkgname-$pkgver" \
        --prefix=/usr                \
        --libexecdir=/usr/libexec/rc \
        --sbindir=/usr/bin           \
        --bindir=/usr/bin            \
        --libdir=/usr/lib            \
        -Dbash-completions=true      \
        -Dbranding='"Krelpin Linux"' \
        -Dpam=false                  \
        -Daudit=disabled             \
        -Dpkg_prefix=''              \
        -Dpkgconfig=true             \
        -Dselinux=disabled           \
        -Dsysconfdir=/etc            \
        -Dzsh-completions=false
    meson compile -C build
}

check() {
    true
}

package() {
    meson install -C build --destdir "$pkgdir"

    ln -s openrc-init "$pkgdir/usr/bin/init"

    # install default inittab
    install -Dm644 "$srcdir/$pkgname-$pkgver/support/sysvinit/inittab" "$pkgdir/etc/inittab"

    # rotate boot log
    install -Dm0644 "$srcdir/$pkgname.logrotate" "$pkgdir/etc/logrotate.d/$pkgname"

    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
