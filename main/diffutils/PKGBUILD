# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Sébastien Luttringer <seblu@archlinux.org>

pkgname=diffutils
pkgver=3.12
pkgrel=2
pkgdesc='Utility programs used for creating patch files'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/diffutils'
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/diffutils/diffutils-${pkgver}.tar.xz"{,.sig})
validpgpkeys=('155D3FC500C834486D1EEA677FD9FCCB000BEEEE') # Jim Meyering <meyering@meta.com>
sha256sums=('SKIP'
            'SKIP')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-gcc-warnings
  make
}

check() {
  cd "${pkgname}-${pkgver}"
  make check || true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="$pkgdir" install
}
