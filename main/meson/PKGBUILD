# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=meson
pkgver=1.7.0
pkgrel=1
pkgdesc='High productivity build system'
arch=('any')
url='https://mesonbuild.com/'
license=('Apache-2.0')
depends=('python' 'ninja')
makedepends=('python-setuptools')
source=("https://github.com/mesonbuild/meson/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  LD_LIBRARY_PATH="${SYSROOT}/usr/lib" python setup.py build
}

package() {
  cd "${pkgname}-${pkgver}"
  LD_LIBRARY_PATH="${SYSROOT}/usr/lib" python setup.py install \
    --root="${pkgdir}" --prefix=/usr --optimize=1 --skip-build
  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
