pkgname=sed
pkgver=4.10
pkgrel=2
pkgdesc='GNU stream editor'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/sed/'
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/sed/sed-${pkgver}.tar.gz")
sha256sums=('4d179ffaf92ec4dcec541f7c032be1c3b9a1856f4970adb95a505221702f5277')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --without-selinux
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
