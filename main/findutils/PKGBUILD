# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Tobias Powalowski <tpowa@archlinux.org>

pkgname=findutils
pkgver=4.11.0
pkgrel=1
pkgdesc="GNU utilities to locate files"
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('GPL-3.0-or-later')
depends=('glibc')
url='https://www.gnu.org/software/findutils/'
source=("https://ftp.gnu.org/gnu/findutils/findutils-${pkgver}.tar.xz")
sha256sums=('bfd19cb06cc71f3352d567e90284d8cdac02ac89774bbeadf0b533b0c11432fd')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure --prefix=/usr
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
