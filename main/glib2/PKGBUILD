# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=glib2
pkgver=2.82.5
pkgrel=1
pkgdesc='Low level core library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://gitlab.gnome.org/GNOME/glib'
license=('LGPL-2.1-or-later')
# TODO: add libsysprof-capture and pcre2 jit once profiling is wanted
depends=('glibc' 'pcre2' 'libffi' 'zlib' 'util-linux')
makedepends=('meson' 'ninja' 'python')
provides=('libgio-2.0.so' 'libglib-2.0.so' 'libgmodule-2.0.so' 'libgobject-2.0.so' 'libgthread-2.0.so')
source=("https://download.gnome.org/sources/glib/${pkgver%.*}/glib-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  meson setup "glib-${pkgver}" build \
    --prefix=/usr --libdir=lib --buildtype=release \
    -Dman-pages=disabled \
    -Dgtk_doc=false \
    -Dtests=false \
    -Dsysprof=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
