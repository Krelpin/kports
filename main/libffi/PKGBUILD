# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libffi
pkgver=3.4.6
pkgrel=1
pkgdesc='Portable foreign function interface library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://sourceware.org/libffi/'
license=('MIT')
depends=('glibc')
provides=('libffi.so')
source=("https://github.com/libffi/libffi/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --disable-static \
    --disable-multi-os-directory \
    --disable-exec-static-tramp
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
