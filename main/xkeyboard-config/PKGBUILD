# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=xkeyboard-config
pkgver=2.44
pkgrel=1
pkgdesc='X keyboard configuration files'
arch=('any')
url='https://www.freedesktop.org/wiki/Software/XKeyboardConfig/'
license=('MIT')
makedepends=('meson' 'ninja' 'python')
source=("https://xorg.freedesktop.org/archive/individual/data/${pkgname}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  meson setup "${pkgname}-${pkgver}" build \
    --prefix=/usr --libdir=lib --buildtype=release \
    -Dxkb-base=/usr/share/X11/xkb
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
