# Contributor: Aaron Griffin <aaron@archlinux.org>

pkgname=shadow
pkgver=4.20.2
pkgrel=1
pkgdesc="Password and account management tool suite"
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url="https://github.com/shadow-maint/shadow"
license=('BSD-3-Clause')
depends=('glibc')
backup=('etc/default/useradd' 'etc/login.defs')
options=('!emptydirs')
source=("https://github.com/shadow-maint/shadow/releases/download/${pkgver}/shadow-${pkgver}.tar.xz"
        'useradd.defaults')
sha256sums=('b89f432b75ae55a2d852b446d0365484795fdf533ab97d550e325fa15594a224'
            'b3056f0a7768f08b135f02bfbc6a88659f0c54cfbf3803f33a23d542b6b97f88')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --bindir=/usr/bin \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --without-libpam \
    --without-audit \
    --without-selinux \
    --without-acl \
    --without-attr \
    --without-libbsd \
    --without-nscd \
    --without-su \
    --disable-man \
    --disable-account-tools-setuid \
    --with-group-name-max-length=32
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -vDm 644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}/"
  install -vDm 600 "${srcdir}/useradd.defaults" "${pkgdir}/etc/default/useradd"
}
