# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Thomas Bächler <thomas@archlinux.org>

pkgname=iw
pkgver=6.17
pkgrel=1
pkgdesc='nl80211 based CLI configuration utility for wireless devices'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://wireless.wiki.kernel.org/en/users/documentation/iw'
license=('GPL-2.0-only')
depends=('glibc' 'libnl')
source=("https://kernel.org/pub/software/network/iw/iw-${pkgver}.tar.xz")
sha256sums=('7d182e498289ab39b257da6780d562e415377107f50358ee5b55b8cfe40b1e33')

build() {
  cd "${pkgname}-${pkgver}"
  make CFLAGS="${CFLAGS} -I${PKG_CONFIG_SYSROOT_DIR}/usr/include/libnl3"
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" SBINDIR="/usr/bin" install
}
