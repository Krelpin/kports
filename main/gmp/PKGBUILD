# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=gmp
pkgver=6.3.0
pkgrel=1
pkgdesc='A free library for arbitrary precision arithmetic'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://gmplib.org/'
license=('GPL-2.0-or-later' 'LGPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('libtool')
source=("https://ftp.gnu.org/gnu/gmp/${pkgname}-${pkgver}.tar.xz"
        'gmp-gcc-15.patch')
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd "${pkgname}-${pkgver}"
  patch -p1 < ../gmp-gcc-15.patch
  autoreconf -vif
}

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --enable-cxx --enable-fat
  make
}

package() {
  make -C "${pkgname}-${pkgver}" DESTDIR="${pkgdir}" install
}
