# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=android-headers
pkgver=16.0
pkgrel=2
pkgdesc='Android platform headers used to build against the vendor HALs'
arch=('any')
url='https://github.com/Halium/android-headers'
license=('Apache-2.0')
_branch="halium-${pkgver}"
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Halium/${pkgname}/archive/refs/heads/${_branch}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${pkgname}-${_branch}"
  make PREFIX=/usr DESTDIR="${pkgdir}" install
}
