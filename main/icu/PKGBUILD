# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=icu
pkgver=76.1
_srcver=76_1
pkgrel=1
pkgdesc='International Components for Unicode library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://icu.unicode.org/'
license=('ICU')
depends=('glibc' 'gcc-libs')
source=("https://github.com/unicode-org/icu/releases/download/release-${pkgver//./-}/icu4c-${_srcver}-src.tgz")
sha256sums=('SKIP')

build() {
  cd icu/source
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --disable-samples \
    --disable-tests
  make
}

package() {
  cd icu/source
  make DESTDIR="${pkgdir}" install
}
