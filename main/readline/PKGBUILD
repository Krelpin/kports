# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=readline
pkgver=8.2
pkgrel=1
pkgdesc='GNU readline library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://tiswww.case.edu/php/chet/readline/rltop.html'
license=('GPL-3.0-or-later')
depends=('glibc' 'ncurses')
provides=('libreadline.so' 'libhistory.so')
source=("https://ftp.gnu.org/gnu/readline/readline-${pkgver}.tar.gz")
sha256sums=('3feb7171f16a84ee82ca18a36d7b9be109a52c04f492a053331d7d1095007c35')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --with-curses \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info
  make SHLIB_LIBS="-lncursesw"
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
