# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=md4c
pkgver=0.5.2
pkgrel=1
pkgdesc='C Markdown parser'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://github.com/mity/md4c'
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'ninja')
provides=('libmd4c.so' 'libmd4c-html.so')
source=("https://github.com/mity/${pkgname}/archive/release-${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -B build -S "${pkgname}-release-${pkgver}" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_SHARED_LIBS=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
