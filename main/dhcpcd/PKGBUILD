# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: David Runge <dvzrv@archlinux.org>

pkgname=dhcpcd
pkgver=10.5.2
pkgrel=1
pkgdesc="DHCP/ IPv4LL/ IPv6RA/ DHCPv6 client"
url="https://roy.marples.name/projects/dhcpcd/"
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('BSD-2-Clause')
depends=('glibc' 'sh')
provides=('dhcp-client')
backup=('etc/dhcpcd.conf')
options=('emptydirs')
source=("https://github.com/NetworkConfiguration/$pkgname/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz")
sha256sums=('3e476657fdb6eeb38b277da3a48d0ac0113ecce5858ebdcddff2b629faed52b4')

prepare() {
  cd "$pkgname-$pkgver"
  printf "# Do not attempt to obtain an IPv4LL address if we failed to get one via DHCP. See RFC 3927.\nnoipv4ll\n" >> src/$pkgname.conf
}

build() {
  cd "$pkgname-$pkgver"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib/$pkgname \
    --dbdir=/var/lib/$pkgname \
    --runstatedir=/run \
    --privsepuser=root \
    --without-udev \
    --without-openssl
  make
}

check() {
  true
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
