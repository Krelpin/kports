# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libliftoff
pkgver=0.5.0
pkgrel=1
pkgdesc='Lightweight KMS plane library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://gitlab.freedesktop.org/emersion/libliftoff'
license=('MIT')
depends=('glibc' 'libdrm')
makedepends=('meson' 'ninja')
provides=('libliftoff.so')
source=("https://gitlab.freedesktop.org/emersion/${pkgname}/-/releases/v${pkgver}/downloads/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  meson setup "${pkgname}-${pkgver}" build \
    --prefix=/usr --libdir=lib --buildtype=release
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
