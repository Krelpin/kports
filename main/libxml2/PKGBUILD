# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libxml2
pkgver=2.13.5
pkgrel=1
pkgdesc='XML parsing library, version 2'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://gitlab.gnome.org/GNOME/libxml2'
license=('MIT')
depends=('bash' 'glibc' 'icu' 'readline' 'zlib' 'xz')
provides=('libxml2.so')
source=("https://download.gnome.org/sources/${pkgname}/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --disable-static \
    --with-icu \
    --with-readline \
    --with-threads \
    --with-history \
    --without-python
  make
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
