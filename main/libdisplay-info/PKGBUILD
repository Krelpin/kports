# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libdisplay-info
pkgver=0.2.0
pkgrel=1
pkgdesc='EDID and DisplayID library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://gitlab.freedesktop.org/emersion/libdisplay-info'
license=('MIT')
depends=('glibc' 'hwdata')
makedepends=('meson' 'ninja' 'python')
provides=('libdisplay-info.so')
source=("https://gitlab.freedesktop.org/emersion/${pkgname}/-/releases/${pkgver}/downloads/${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  meson setup "${pkgname}-${pkgver}" build \
    --prefix=/usr --libdir=lib --buildtype=release
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
