# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=expat
pkgver=2.6.4
pkgrel=1
pkgdesc='An XML parser library'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://libexpat.github.io/'
license=('MIT')
depends=('glibc')
provides=('libexpat.so')
source=("https://github.com/libexpat/libexpat/releases/download/R_${pkgver//./_}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('a695629dae047055b37d50a0ff4776d1d45d0a4c842cf4ccee158441f55ff7ee')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --mandir=/usr/share/man \
    --without-docbook \
    --without-examples \
    --without-tests
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
