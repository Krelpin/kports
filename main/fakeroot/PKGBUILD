pkgname=fakeroot
pkgver=1.37.1.1
pkgrel=1
pkgdesc='Tool for simulating superuser privileges'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
license=('GPL-3.0-or-later')
url='https://tracker.debian.org/pkg/fakeroot'
depends=('glibc' 'sed' 'util-linux')
source=("https://deb.debian.org/debian/pool/main/f/fakeroot/fakeroot_${pkgver}.orig.tar.gz")
sha256sums=('86b0b75bf319ca42e525c098675b6ed10a06b76e69ec9ccf20ef5e03883b3a14')

build() {
  cd "${pkgname}-${pkgver}"

  CFLAGS+=" -include linux/capability.h"
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib/libfakeroot \
    --disable-static \
    --with-ipc=sysv
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -dm0755 "${pkgdir}/usr/lib/ld.so.conf.d/"
  echo '/usr/lib/libfakeroot' > "${pkgdir}/usr/lib/ld.so.conf.d/fakeroot.conf"
}
