# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libgudev
pkgver=238
pkgrel=1
pkgdesc='GObject bindings for libudev'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://gitlab.gnome.org/GNOME/libgudev'
license=('LGPL-2.1-or-later')
depends=('eudev' 'glib2')
makedepends=('meson' 'ninja' 'pkgconf')
provides=('gudev-1.0')
source=("https://download.gnome.org/sources/${pkgname}/${pkgver}/${pkgname}-${pkgver}.tar.xz")
sha256sums=('SKIP')

build() {
  meson setup "${pkgname}-${pkgver}" build \
    --prefix=/usr --libdir=lib --buildtype=release \
    -Dgtk_doc=false -Dintrospection=disabled -Dvapi=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}
