# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libglibutil
pkgver=1.0.82
pkgrel=1
_commit=cccc4aa8f1745096f6feb66da7883b35055d9423
pkgdesc='GLib utility library used by libgbinder'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://github.com/sailfishos/libglibutil'
license=('BSD-3-Clause')
depends=('glib2')
makedepends=('pkgconf')
source=("${pkgname}-${_commit}.tar.gz::https://github.com/sailfishos/libglibutil/archive/${_commit}.tar.gz")
sha256sums=('SKIP')

build() {
  make -C "${pkgname}-${_commit}" release pkgconfig KEEP_SYMBOLS=1
}

package() {
  make -C "${pkgname}-${_commit}" DESTDIR="${pkgdir}" LIBDIR=usr/lib install-dev
}
