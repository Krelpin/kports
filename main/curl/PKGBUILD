# Maintainer: Krelpin Developers <dev@krelpin.org>
# Contributor: Dave Reisner <dreisner@archlinux.org>

pkgname=curl
pkgver=8.12.1
pkgrel=1
pkgdesc='Command line tool and library for transferring data with URLs'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://curl.se/'
license=('curl')
depends=(
  'glibc'
  'zstd'
)
provides=('libcurl.so')
source=("https://github.com/curl/curl/releases/download/curl-${pkgver//./_}/curl-${pkgver}.tar.xz")
sha256sums=('0341f1ed97a26c811abaebd37d62b833956792b7607ea3f15d001613c76de202')

build() {
  cd "${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --mandir=/usr/share/man \
    --disable-ldap \
    --disable-ldaps \
    --disable-manual \
    --with-openssl \
    --with-zstd
  make
}

check() {
  true
}

package() {
  cd "${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
