# Maintainer: Krelpin Developers <dev@krelpin.org>

pkgname=libidn2
pkgver=2.3.8
pkgrel=1
pkgdesc='Free software implementation of the updated IDNA specification'
arch=('aarch64' 'x86_64' 'armv7h' 'riscv64')
url='https://www.gnu.org/software/libidn/#libidn2'
license=('GPL-2.0-or-later' 'LGPL-3.0-or-later')
depends=('libunistring')
provides=('libidn2.so')
source=("https://ftp.gnu.org/gnu/libidn/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  make -C "${pkgname}-${pkgver}" DESTDIR="${pkgdir}" install
}
